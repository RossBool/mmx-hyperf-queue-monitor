APP_NAME=alarm-server
APP_ENV=dev
APP_DEBUG=true
SCAN_CACHEABLE=false

# ---- MySQL 8.0.16+ (8.0.16 之前 CHECK 约束会被静默忽略) ----
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alarm
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
# 必须与 schema.sql 的表定义一致 (MySQL 8.0 默认排序规则)
DB_COLLATION=utf8mb4_0900_ai_ci
DB_PREFIX=
DB_MAX_IDLE_TIME=60

# ---- Redis (hyperf/cache 默认 store 使用) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_DRIVER=default
