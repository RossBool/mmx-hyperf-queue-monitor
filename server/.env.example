APP_NAME=alarm-server
APP_ENV=dev
APP_DEBUG=true
SCAN_CACHEABLE=false

# ---- MySQL 8.0.16+ (8.0.16 之前 CHECK 约束会被静默忽略) ----
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alarm
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
# 必须与 schema.sql 的表定义一致 (MySQL 8.0 默认排序规则)
DB_COLLATION=utf8mb4_0900_ai_ci
DB_PREFIX=
DB_MAX_IDLE_TIME=60

# ---- Redis (hyperf/cache 默认 store 使用) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_DRIVER=default

# ---- 鉴权（占位中间件，契约 §0.1）----
# token 白名单，逗号分隔。
# ⚠️ 必须留空：fail-closed 语义下，本行留空 = 拒绝所有请求（401）。
#    这里**绝不能**预填任何可用值——`composer install` 会自动把本文件 copy 成 .env，
#    预填的 token 会被任何拿到仓库的人读到，等于把 fail-closed 换成「用公开凭据的有鉴权」。
#    本地联调请自己生成并写进 .env（不要改回本文件）：
#        php -r 'echo bin2hex(random_bytes(24)), PHP_EOL;'
#    多个 token 用逗号分隔。接入真实登录态后由 token 解析取代本配置。
ALARM_STATIC_TOKENS=
# 仅本地联调：显式关闭鉴权。生产环境禁止设置。默认 false。
ALARM_AUTH_DISABLED=false
# 当前登录人姓名（creatorName / handlerName）。接入真实用户服务后改由 token 解析。
ALARM_CURRENT_USER=张三
