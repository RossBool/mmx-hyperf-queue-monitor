# This is api base url
# VITE_API_BASE_URL=https://api.example.com

# 后端 Hyperf 服务地址，与 /workspace/docs/alarm/contract.md §0.1 的 Base URL 约定一致：
# 最终请求前缀 = VITE_SERVER_API_URL + VITE_SERVER_API_PREFIX = http://localhost:3000/api
VITE_SERVER_API_URL=http://localhost:3000
VITE_SERVER_API_PREFIX=/api
VITE_SERVER_API_TIMEOUT=5000

# Mock 开关。后端未就绪时改成 true，前端走 src/mocks/ 的本地数据，不发真实 HTTP 请求。
# 接受 'true' / '1'，其余一律为 false。
VITE_USE_MOCK=false

# 告警接口 Bearer token —— 契约 §0.1。
# ⚠️ 后端 AuthMiddleware 是 fail-closed 的（ALARM_STATIC_TOKENS 未配置时拒绝所有请求），
#    这里留空 = 连真实后端一律 401。取值必须与后端 ALARM_STATIC_TOKENS 白名单一致。
# 接入真实登录态后改为运行时读取，不要长期写死在 env。
VITE_SERVER_API_TOKEN=
